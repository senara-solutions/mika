# Mika — Required Environment Variables
# Copy this file to .env and fill in your values.

# Anthropic credential (required) — API key or OAuth subscription token
# API key (billed):          MIKA_ANTHROPIC_API_KEY=sk-ant-api03-...
# OAuth token (subscription): MIKA_ANTHROPIC_API_KEY=sk-ant-oat01-...
#   Get OAuth token via: claude setup-token (from Claude Code CLI)
MIKA_ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key for Layer 3 vector search (optional; FTS5 fallback if unset)
# MIKA_OPENAI_API_KEY=sk-...

# Brave Search API key for web search skill (optional; get free key at brave.com/search/api)
# MIKA_BRAVE_API_KEY=BSA...

# Optional: Override defaults from config/default.toml
# MIKA_CLAUDE_MODEL=claude-sonnet-4-6
# MIKA_CLAUDE_MAX_TOKENS=4096
# MIKA_DB_PATH=mika.db
# MIKA_LOG_LEVEL=info
# MIKA_EMBEDDING_MODEL=text-embedding-3-small
# MIKA_EMBEDDING_DIMENSIONS=512
# MIKA_DISABLE_BUNDLED_SKILLS=false  # WARNING: do not enable in production

# Optional: OpenTelemetry trace export (requires --features telemetry at build time)
# NOTE: The endpoint must include the full path with /v1/traces — it is NOT auto-appended.
# MIKA_TELEMETRY_ENABLED=true
# MIKA_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces  (Langfuse)
# MIKA_OTLP_ENDPOINT=http://localhost:4318/v1/traces                       (Jaeger)
# MIKA_OTLP_AUTH_HEADER=publicKey:secretKey  (raw or base64-encoded, Langfuse only)

# Optional: Dashboard CORS origin (default: http://localhost:5173)
# MIKA_CORS_ORIGIN=http://localhost:5173

# Optional: Log file paths for server/gateway (logs go to stdout + file when set)
# MIKA_SERVER_LOG_FILE=/var/log/mika/server.log

# --- Gateway mode (mika-gateway binary) ---
# Required when running the gateway:
# MIKA_DATABASE_URL=postgres://user:pass@localhost/mika
# MIKA_TELEGRAM_BOT_TOKEN=<your Telegram bot token>
# MIKA_TELEGRAM_WEBHOOK_SECRET=<64 hex chars — openssl rand -hex 32>
# MIKA_TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram
# MIKA_GATEWAY_PORT=8080
# MIKA_AGENT_BASE_URL=http://localhost:8080  # local E2E testing only
# MIKA_GATEWAY_LOG_FILE=                     # optional log file path
