+assert_eq "mika#2165: chaque --log-dir est valué par le résolveur" "3" \
     "$(grep -cF -- '--log-dir "$_PILOT_LOG_DIR"' "$DISPATCH_LIB" || true)"
 
 # L'assertion de comportement : la surcharge posée APRÈS le source est honorée.
