+
+# --- T6 : contrôle négatif — l'architecte n'a rien demandé -------------------
+
+T2306_T6=$(_t2306_revise_probe "$T2306_FINDINGS_WITHOUT_FD" "no" "never")
+assert_eq "T6: findings sans mention de FD ⇒ zéro relance" \
