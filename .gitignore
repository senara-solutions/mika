# Rust
/target/
**/*.rs.bk

# Environment variables
.env
.env.local
.env.production

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python — `scripts/` carries executable Python; running any of it
# writes bytecode next to the source. The make targets pass -B, but a
# direct `python3 scripts/...` invocation still would.
__pycache__/
*.pyc

# Node
node_modules/
# dashboard/dist/ is a build artifact — embedded into mika-server via rust-embed at compile time.
# Run `make deploy` or `npm run build --prefix dashboard` to produce it.
dashboard/dist/

# Data
data/
*.db
*.sqlite
.claude/*.local.json
.claude/*.local.md
compound-engineering.local.md
.claude/worktrees
.claude/scheduled_tasks.lock
.claude/groom-verdict-trail.log
node_modules

# Lefthook
lefthook-local.yml
.context/compound-engineering/

# `.iterate/` — dispatch-lib rescue-path scratch (findings, escalate markers).
# Written by dev-groom/dev-pilot iteration loop as ephemeral session state;
# NEVER meant to persist. Committing these files causes rebase conflicts on
# every stale branch touched by dispatch-lib after a fresh iteration run
# (mika#1705 blocked 2× on this class, 41 commits behind).
.iterate/

# `pr-body.md` — the PR body a pilot writes at the worktree root before
# `gh pr create --body-file` (mika#2211). It is deleted right after, but the
# ignore is what makes the residue harmless: `git status --porcelain` — the
# dirty-worktree probe dispatch-lib runs — does not report ignored files, so a
# failed `gh pr create` that leaves the file behind can no longer trip the
# mika#1282 wip-rescue recovery it was written to avoid.
/pr-body.md
