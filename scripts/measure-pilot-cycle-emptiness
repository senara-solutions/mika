#!/usr/bin/env bash
# measure-pilot-cycle-emptiness — how often does a claude-pilot session finish
# without having done anything, and what actually stopped it?
#
# THE PROPERTY, not a list of greps:
#   "The pilot produced nothing" is a claim about a population, and the only
#   honest way to hold it is a command anybody can re-run. The measurement of
#   2026-08-29 that founds this whole line of work ("102 of 120 sessions silent")
#   left NO reproducible gesture: it survives as one sentence inside a principle
#   document, with no command and no artifact. That is why mika#1950 sat open for
#   a month — the question "has the symptom moved?" could not be re-asked without
#   redoing the work. This script is that gesture.
#
# WHY IT EXISTS RATHER THAN THE REPLAY THE TICKET PRESCRIBED. mika#1950 asks for
# two JSONL fixtures to be replayed under glm-5.2 then glm-5.3. Those fixtures
# exist nowhere — not in the tree, not in `git log --all`, not in the workspace
# (see docs/eval/mika-1950/README.md §1, which carries the commands). The corpus
# under /var/log/claude-pilot is what exists instead: three months of the real
# 30-turn tool loop, three orders of magnitude larger than the two absent files.
#
# THE ONE TRAP THIS SCRIPT IS BUILT AROUND. 2349 of the 2352 sessions carry
#
#     [guardrails] maxTurns=200 stallThreshold=5 emptyResponseThreshold=5 …
#
# so `grep empty` reports ~2349 "silent sessions": a number that is wrong,
# plausible, and dressed as a measurement. The anchor below is therefore derived
# from the PRODUCER, never reverse-engineered from a log:
#
#     claude-pilot  src/claude_pilot/guardrails.py:845
#       self._abort("empty_response", f"{n} consecutive trivial responses …")
#     claude-pilot  src/claude_pilot/ui.py:113
#       _log(f"\n{ORANGE}[guardrail]{RESET} {BOLD}{type_}{RESET}: {detail}")
#
#   giving, on disk:
#     ^[[38;5;208m[guardrail]^[[0m ^[[1mempty_response^[[0m: 5 consecutive …
#
#   Two steps, and the order is load-bearing: strip ANSI CSI, THEN match
#   `[guardrail] <type>:` at start of line. A pattern written against the
#   coloured line would encode `^[[1m` between the marker and the type and break
#   on the next theme change in ui.py.
#
# TOOL CALLS ARE COUNTED FROM BOTH PRODUCERS, and this diverges from the letter
# of the plan (which named `[tool:request]` alone). Measured on 2026-09-20:
# `[tool:request]` (the relay path, ui.py:83) appears in 1769 sessions and
# `[tool]` (the direct path, ui.py:42) in 849. They are two dispatch paths, not
# duplicates. Counting only the first would classify ~850 genuinely working
# sessions as empty — the same shape of false-but-plausible number the anchor
# above exists to prevent.
#
# FAIL-SAFE, ALWAYS TOWARD `undetermined`. A signal that cannot be read is never
# a satisfied term: an unreadable file, a missing `[init]` header, a model string
# that does not look like a model — each renders `undetermined`, never `produced`
# and never `empty`. The three-valued vocabulary is mika#1996's, deliberately:
# a second dialect would split one population in two without saying so.
#
# WHAT IT DOES NOT MEASURE. The GLM half. These sessions are claude-pilot, the
# IMPLEMENTATION surface, which runs under Claude; `mika-dev`, the DISPATCHER, is
# what carries GLM. Its turns live in $MIKA_SPIRIT_LOG_FILE (`turn_usage`,
# `llm_budget_resolved`) and are an operator gesture on the host. Reading a
# verdict about a model out of this output is the exact confusion mika#1950's own
# framing makes; README §3 separates the two axes and §5 prescribes the other one.
#
# THE `date` FIELD IS A CALENDAR DAY AND NOTHING MORE. It is not a regime axis:
# the population runs under Claude on both sides of 2026-08-26, so the GLM swap
# changed the model of none of these sessions. A discontinuity there is a
# calendar correlation whose causal channel is unestablished — see README §3.
#
# USAGE
#   scripts/measure-pilot-cycle-emptiness [--log-dir DIR] [--out FILE] [--limit N]
#
#   --log-dir  default /var/log/claude-pilot
#   --out      default stdout
#   --limit N  the N most RECENT sessions (the 102/120 cross-check needs this end)
#
# OUTPUT — one JSON object per session, newline-delimited, newest first.
#
# EXIT CODES
#   0  the corpus was read
#   2  nothing was measured (no such directory, not a directory, no *.stderr).
#      Never 0: a silently inert scan reads exactly like a scan that found
#      nothing to report, and that ambiguity is its own defect class (mika#2205).

set -uo pipefail

LOG_DIR="/var/log/claude-pilot"
OUT_FILE=""
LIMIT=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --log-dir) LOG_DIR="${2:-}"; shift 2 ;;
        --out)     OUT_FILE="${2:-}"; shift 2 ;;
        --limit)   LIMIT="${2:-}"; shift 2 ;;
        -h|--help) sed -n '2,90p' "$0"; exit 0 ;;
        *) printf 'measure-pilot-cycle-emptiness: unknown argument: %s\n' "$1" >&2; exit 2 ;;
    esac
done

if [[ -z "$LOG_DIR" || ! -d "$LOG_DIR" ]]; then
    printf 'measure-pilot-cycle-emptiness: not a directory: %s — nothing measured\n' \
        "${LOG_DIR:-<empty>}" >&2
    exit 2
fi

if [[ -n "$LIMIT" ]] && ! [[ "$LIMIT" =~ ^[1-9][0-9]*$ ]]; then
    printf 'measure-pilot-cycle-emptiness: --limit must be a positive integer, got: %s\n' \
        "$LIMIT" >&2
    exit 2
fi

WORK="$(mktemp -d)" || exit 2
trap 'rm -rf "$WORK"' EXIT

# -- the index -----------------------------------------------------------------
#
# `epoch date readable path`, newest first. Built in one find so the mtime and
# the path can never disagree, and carrying UNREADABLE paths too: a file we
# cannot open must come out as `undetermined`, not vanish from the population.
# Dropping it would quietly shrink the denominator of every ratio downstream.

find "$LOG_DIR" -maxdepth 1 -type f -name '*.stderr' \
    -printf '%T@\t%TY-%Tm-%Td\t%p\n' 2>/dev/null \
    | sort -rn >"$WORK/all" || true

if [[ ! -s "$WORK/all" ]]; then
    printf 'measure-pilot-cycle-emptiness: no *.stderr under %s — nothing measured\n' \
        "$LOG_DIR" >&2
    exit 2
fi

if [[ -n "$LIMIT" ]]; then
    head -n "$LIMIT" "$WORK/all" >"$WORK/sel"
else
    cp "$WORK/all" "$WORK/sel"
fi

# READABLE is an array, not a whitespace-joined string: a path is data, and
# splitting one on spaces is how a file silently leaves the population.
READABLE=()
: >"$WORK/index"
while IFS=$'\t' read -r _epoch day path; do
    if [[ -r "$path" ]]; then
        printf '%s\t1\t%s\n' "$day" "$path" >>"$WORK/index"
        READABLE+=("$path")
    else
        printf '%s\t0\t%s\n' "$day" "$path" >>"$WORK/index"
    fi
done <"$WORK/sel"

# -- the single pass -----------------------------------------------------------
#
# awk reads the index first (recognised by filename), then every readable log.
# Emission is driven by the INDEX, not by the files awk happened to visit, so a
# zero-byte log — which yields no records at all — still produces its line.

emit() {
    awk -v IDX="$WORK/index" '
    function json_escape(s) {
        gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s)
        return s
    }
    # The THREE-step rule of the header, and the order is load-bearing.
    #
    #   1. strip ANSI CSI          — the colours ui.py writes
    #   2. strip the line stamp    — claude-pilot logger.py::_LineStamper, added
    #                                by cpp#168: EVERY line is prefixed with
    #                                `[YYYY-MM-DDTHH:MM:SS.mmmZ] `. It is applied
    #                                to the already-coloured message, so on disk
    #                                the stamp comes FIRST and this step comes
    #                                second.
    #   3. match the anchors at start of line
    #
    # Step 2 is not defensive padding: it is a dated format change in a
    # third-party repo. Without it every session logged after ~2026-09-10 loses
    # its `[init]` header and renders `undetermined` — measured at 231 sessions,
    # i.e. the whole of September, the period that matters most. The fail-safe
    # did its job (no false value was ever produced) and the elevated
    # `undetermined` count is exactly the signal the plan said to read.
    #
    # The stamp pattern is spelled out digit by digit rather than with ERE
    # intervals: it must not be able to match a bracketed token that merely
    # looks date-ish in session content, and it stays portable across awks.
    function strip(s) {
        gsub(/\033\[[0-9;]*m/, "", s)
        sub(/^\[[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\.[0-9][0-9][0-9]Z\] /, "", s)
        return s
    }

    FILENAME == IDX {
        n++
        split($0, f, "\t")
        day[n] = f[1]; readable[n] = f[2]; path[n] = f[3]
        idx_of[f[3]] = n
        next
    }

    {
        i = idx_of[FILENAME]
        if (i == 0) next
        line = strip($0)

        # Two dispatch paths, counted apart and summed. ui.py:83 and ui.py:42.
        if (line ~ /^\[tool:request\] /) { treq[i]++ }
        else if (line ~ /^\[tool\] /)    { tinv[i]++ }

        if (line ~ /^\[policy:deny\] /) deny[i]++
        if (line ~ /^\[error\] error_during_execution:/) ede[i] = 1

        # ui.py:27-29 —
        #   task_str = f", task {task_id}" if task_id else ""
        #   f"{DIM}[init]{RESET} Session {sid[:8]}, model {model}{task_str}"
        # so the trailing `, task <uuid>` is OPTIONAL and both forms are in the
        # corpus. Cutting at the next comma handles both; an anchor written
        # against only the short form reads every real session as unreadable and
        # renders the whole population `undetermined` — measured, 2353/2353.
        # The first `[init]` wins: a later `[reconnect]` restates the same model.
        if (model[i] == "" && line ~ /^\[init\] Session .*, model /) {
            m = line
            sub(/^.*, model /, "", m)
            sub(/,.*$/, "", m)
            sub(/[ \t\r]+$/, "", m)
            # Fail-safe: a model string that does not look like one is not a
            # model. `claude-opus-4-8[1m]` is in the corpus, hence the suffix.
            if (m ~ /^[A-Za-z0-9][A-Za-z0-9\/._:+-]*(\[[0-9A-Za-z]+\])?$/) model[i] = m
        }

        # The anchor, generalised: the TYPE is captured, never presumed.
        # `error_max_turns` reaches log_guardrail from agent.py:842 as an SDK
        # termination subtype and is absent from guardrails.py::_abort Literal[…],
        # so a script that only knew that list would drop it in silence.
        if (line ~ /^\[guardrail\] [A-Za-z0-9_]+:/) {
            t = line
            sub(/^\[guardrail\] /, "", t)
            sub(/:.*$/, "", t)
            aborts[i] = (aborts[i] == "" ? t : aborts[i] "," t)
            if (t == "empty_response") empty_ev[i] = 1
        }
    }

    END {
        for (i = 1; i <= n; i++) {
            tid = path[i]
            sub(/^.*\//, "", tid); sub(/\.stderr$/, "", tid)

            calls = treq[i] + tinv[i]

            # Fail-safe, in one place: unreadable file, or no readable [init]
            # header, means we cannot say what this session did.
            if (readable[i] != "1" || model[i] == "")
                verdict = "undetermined"
            else if (calls > 0)
                verdict = "produced"
            else
                verdict = "empty"

            arr = "["
            if (aborts[i] != "") {
                k = split(aborts[i], parts, ",")
                for (j = 1; j <= k; j++)
                    arr = arr (j > 1 ? "," : "") "\"" json_escape(parts[j]) "\""
            }
            arr = arr "]"

            printf "{\"task_id\":\"%s\",\"date\":\"%s\",\"model\":%s,", \
                json_escape(tid), day[i], \
                (model[i] == "" ? "null" : "\"" json_escape(model[i]) "\"")
            printf "\"tool_calls\":%d,\"tool_requests\":%d,\"tool_invocations\":%d,", \
                calls, treq[i] + 0, tinv[i] + 0
            printf "\"policy_denies\":%d,\"empty_event\":%s,", \
                deny[i] + 0, (empty_ev[i] ? "true" : "false")
            printf "\"guardrail_aborts\":%s,\"error_during_execution\":%s,", \
                arr, (ede[i] ? "true" : "false")
            printf "\"verdict\":\"%s\"}\n", verdict
        }
    }
    ' "$WORK/index" ${READABLE[@]+"${READABLE[@]}"}
}
# The `${a[@]+"${a[@]}"}` idiom, not a bare "${READABLE[@]}": under `set -u` an
# empty array is an unbound reference on older bash. Empty is a real state — a
# corpus whose every file is unreadable — and it must emit one `undetermined`
# line per session, not abort. That is the fail-safe, applied to its own harness.

if [[ -n "$OUT_FILE" ]]; then
    emit >"$OUT_FILE"
else
    emit
fi
