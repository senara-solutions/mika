#!/usr/bin/env python3
"""HTTPS CONNECT proxy with hostname allowlist + Anthropic auth reverse-proxy
— dev-pilot containment Phase 2b.

Two invocation modes:

  mika-pilot-egress-proxy --host-unix
      Listens on `/tmp/mika-pilot-egress.sock` (unix socket).
      Two request shapes accepted on the same endpoint (dispatched by method
      + path on the request line):

        (1) CONNECT <host>:<port>  — HTTPS tunnel via allowlist. Existing.
        (2) <METHOD> /anthropic-proxy/...  — HTTP reverse-proxy to
            api.anthropic.com/... with Authorization: Bearer <scoped-key>
            injected host-side. The sandbox NEVER sees the key
            (Q3 shape, sami+coherence-ratified 2026-08-05).

      Runs as long-lived daemon on the host (spawned by dispatch-lib.sh).

  mika-pilot-egress-proxy --sandbox-tcp <PORT>
      Listens on 127.0.0.1:<PORT> (TCP, on sandbox loopback).
      Forwards each connection verbatim to `/tmp/mika-pilot-egress.sock`
      (which is bind-mounted from host by bwrap). No filtering here — the
      host side is the gate. This exists ONLY because most HTTP clients
      (reqwest, node fetch, cargo) don't accept `HTTPS_PROXY=unix:///path`,
      AND because ANTHROPIC_BASE_URL points at this loopback port for the
      auth-injection reverse-proxy flow.

Design rationale (see coherence audit 2026-08-04 + Phase 2b design):

  * `--unshare-net` in bwrap gives a fresh network namespace — the sandbox
    has ONLY `lo` interface. No route to host loopback, no DNS, no anything.
  * The unix socket is the sole escape from the sandbox namespace, and
    only the allowlisted hosts (via CONNECT hostname check) can be reached.
  * DNS is done host-side by this proxy — the sandbox has no resolver
    (nothing bound at /etc/resolv.conf resolution level once net is gone).
  * Raw sockets from sandbox → nowhere to go: no host reachable via TCP.

Allowlist covers the three concrete need classes:
  1. LLM providers: api.anthropic.com, api.openai.com, api.z.ai, openrouter.ai
  2. GitHub (gh CLI, git push/fetch): api.github.com, github.com, ssh.github.com,
     codeload.github.com, objects.githubusercontent.com (LFS)
  3. Package registries used by the pilot's builds:
     - crates.io ecosystem: crates.io, static.crates.io, index.crates.io
     - npm: registry.npmjs.org (some cargo/plugin flows)
     - PyPI: pypi.org, files.pythonhosted.org (uv / pip if the pilot touches Python)

Adding a hostname requires a code change here — deliberate friction. If a
pilot needs to reach a new host, that surfaces as a proxy-403 in its logs
and gets a governance decision.

Failure modes:
  * 403 Forbidden — hostname not in allowlist.
  * 502 Bad Gateway — upstream connect failed (DNS / connect timeout).
  * 400 Bad Request — malformed CONNECT.
  * Socket errors closed silently — expected on client abort.
"""

import argparse
import asyncio
import datetime
import json
import os
import re
import signal
import socket
import ssl
import stat
import sys
import time
from pathlib import Path


def _log(msg: str) -> None:
    """Sole operator-log emitter for this daemon.

    Prefixes every line with an ISO-8601 UTC timestamp (millisecond
    precision, `Z` suffix) so entries in `/var/log/mika/pilot-egress-proxy.log`
    can be correlated by time against the sibling logs — `server.log` stamps
    its JSON `timestamp` field in the same RFC3339-UTC shape
    (`2026-08-29T03:17:58.081902Z`), and a date grep (`grep 2026-08-28`) now
    composes across both files. Before mika#2030 these lines carried no time
    field, which stalled the mika#1772 / #2029 pilot-stall diagnosis.

    Every stderr line MUST go through here — no bare `print(..., file=sys.stderr)`
    elsewhere — so the timestamp invariant holds for the whole file. `flush=True`
    is preserved: line-by-line ordering is what makes this log readable during
    an incident.
    """
    ts = datetime.datetime.now(datetime.timezone.utc).strftime(
        "%Y-%m-%dT%H:%M:%S.%f"
    )[:-3] + "Z"
    print(f"{ts} {msg}", file=sys.stderr, flush=True)


# Sole security boundary — every entry is a decision.
#
# NOTE: `api.anthropic.com` is deliberately ABSENT from the CONNECT allowlist
# (2026-08-05 root-cause fix). All Anthropic API traffic MUST route through
# the /anthropic-proxy/* reverse-proxy path where host-side OAuth injection
# happens. Any CONNECT tunnel attempt to api.anthropic.com now fails fast
# with a 403, converting a silent hang (SDK trying auth via CONNECT with the
# sandbox placeholder key) into a visible fail-fast — RT#003 (silent→noisy)
# applied at the egress layer.
#
# Diagnostic evidence (canary --enter, 2026-08-05): bundled claude v2.1.191
# with HTTPS_PROXY set + BASE_URL set uses HTTPS_PROXY CONNECT for SOME API
# paths (bypassing BASE_URL). Those calls carry the sandbox's placeholder
# ANTHROPIC_API_KEY (proxy-managed-no-secret) as bearer → Anthropic returns
# 401 or the SDK stalls waiting for a valid response → guardrail idle_timeout
# 300s → PIPELINE FAILURE zero commits. Removing api.anthropic.com from
# CONNECT allowlist forces the SDK to fall back to BASE_URL (verified in
# canary: tool-use flow completes cleanly, tool_use → tool_result exchange
# observed end-to-end).
HOST_ALLOWLIST = frozenset({
    # LLM providers other than Anthropic (Anthropic is REVERSE-PROXIED, not tunneled).
    "api.openai.com",
    "api.z.ai",
    "openrouter.ai",
    # GitHub — the two credential-bearing hosts (api.github.com for the gh CLI,
    # github.com for git smart-HTTP push/fetch) are deliberately ABSENT here:
    # like api.anthropic.com, they are MITM-FORWARDED (see MITM_FORWARD_HOSTS)
    # so the token is injected host-side and the sandbox never holds it
    # (mika#2056). The remaining GitHub hosts carry no credential — codeload
    # (public archives) and objects (LFS blobs) are unauthenticated, ssh is a
    # separate transport — so they stay on the plain encrypted-tunnel path.
    "ssh.github.com",
    "codeload.github.com",
    "objects.githubusercontent.com",
    # Cargo registry ecosystem.
    "crates.io",
    "static.crates.io",
    "index.crates.io",
    # npm registry (some cargo/plugin flows pull JS deps).
    "registry.npmjs.org",
    # PyPI (uv / pip if the pilot touches Python).
    "pypi.org",
    "files.pythonhosted.org",
})

DEFAULT_UNIX_SOCK = "/tmp/mika-pilot-egress.sock"
BUFFER_SIZE = 65536
CONNECT_RE = re.compile(rb"^CONNECT ([^:\s]+):(\d+) HTTP/1\.[01]\r\n", re.ASCII)

# γ auth-injection tunnel (2026-08-05, Vincent-authorized): hosts listed
# here have their CONNECT chained to the local mitmdump daemon rather than
# tunneled directly. mitmdump handles the TLS termination + addon-based
# auth rewrite (see scripts/mika-pilot-anthropic-auth-addon.py) + upstream
# re-TLS. Kept narrow — api.anthropic.com is the sole host where the
# sandbox has no real credential to present (only a placeholder). Other
# LLM providers / registries stay on the plain CONNECT allowlist path where
# the sandbox carries its own credentials (or none) through the encrypted
# tunnel.
#
# mika#2056: api.github.com + github.com JOIN this set. The pilot used to carry
# GH_TOKEN inside the sandbox and present it through the encrypted tunnel — the
# same rejected shape the Anthropic --setenv key once used. Now the sandbox
# holds no GitHub token; mitmdump terminates TLS with its own CA (which the
# sandbox trusts via the combined bundle in dispatch-lib.sh) and
# mika-pilot-github-auth-addon.py injects the credential host-side. The
# addon rewrites ONLY these hosts; every other MITM'd host passes through
# untouched.
MITM_FORWARD_HOSTS = frozenset({
    "api.anthropic.com",
    "api.github.com",
    "github.com",
})
MITM_UPSTREAM_PORT = 8892  # mitmdump --listen-port (managed by dispatch-lib)

# Q3 auth-injection reverse-proxy — path prefix stripped, forwarded to
# api.anthropic.com over TLS with `Authorization: Bearer <subscription-access-token>`
# injected host-side. Voie A (2026-08-05, Vincent-ratified): token source is
# ~/.claude/.credentials.json (the subscription OAuth cred, refreshed by the
# local Claude Code CLI). The proxy is read-only on that file — refresh is
# delegated to the host CLI (natural during Vincent's use + cron keep-warm
# for headless nights). Voie B (proxy owns refresh) is a follow-up.
#
# Vincent's decision (2026-08-05): pilot MUST auth via the paid subscription,
# not a metered API key — cost is flat-and-bounded vs API bill that grows
# with the loop. The blast-radius trade (subscription OAuth = full identity
# vs API key = billing-only) is knowingly accepted because containment is
# for the *pilot* (untrusted code), not the *host* (trusted zone anyway);
# the sandbox stays blind either way.
ANTHROPIC_UPSTREAM_HOST = "api.anthropic.com"
ANTHROPIC_UPSTREAM_PORT = 443
ANTHROPIC_PROXY_PATH_PREFIX = "/anthropic-proxy"
ANTHROPIC_METHOD_RE = re.compile(
    rb"^(GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS) "
    rb"(" + re.escape(ANTHROPIC_PROXY_PATH_PREFIX.encode("ascii")) + rb"[^\s]*)"
    rb" HTTP/1\.[01]\r\n",
    re.ASCII,
)

# Subscription OAuth token — held host-side (never crosses bwrap boundary),
# read from ~/.claude/.credentials.json with mtime-caching so the CLI's
# natural refresh writes are picked up on the next request without proxy
# restart. The proxy NEVER writes this file (Voie A: read-only).
_CREDS_PATH = Path.home() / ".claude" / ".credentials.json"
_OAUTH_TOKEN_PREFIX = "sk-ant-oat"
_token_cache = {"mtime": None, "value": None, "expires_at": None}


def _extract_oauth_token(obj) -> tuple[str | None, float | None]:
    """Walk a JSON-decoded object looking for an OAuth access token +
    optional expiry. Handles multiple credentials.json shapes:

      * flat:   {"accessToken": "...", "expiresAt": 1234567890}
      * nested: {"claudeAiOauth": {"accessToken": "...", "expiresAt": ...}}
      * snake:  {"access_token": "...", "expires_at": ...}
      * any other nested variant

    The heuristic: first string value that starts with `sk-ant-oat` wins;
    expiry is picked from any sibling `expiresAt`/`expires_at`/`exp` key.
    Returns (token, expires_at_seconds) or (None, None).
    """
    def _walk(node, expiry_hint):
        if isinstance(node, dict):
            local_expiry = expiry_hint
            for k, v in node.items():
                if isinstance(v, (int, float)) and k in (
                    "expiresAt", "expires_at", "exp"
                ):
                    # Some sources use ms epoch, some seconds. Detect and
                    # normalize: values > 10^12 are ms since epoch.
                    local_expiry = v / 1000 if v > 1e12 else float(v)
            for k, v in node.items():
                if isinstance(v, str) and v.startswith(_OAUTH_TOKEN_PREFIX):
                    return v, local_expiry
            for v in node.values():
                found = _walk(v, local_expiry)
                if found[0] is not None:
                    return found
        elif isinstance(node, list):
            for item in node:
                found = _walk(item, expiry_hint)
                if found[0] is not None:
                    return found
        return None, None
    return _walk(obj, None)


def read_subscription_token() -> tuple[str | None, float | None]:
    """Return (access_token, expires_at) from ~/.claude/.credentials.json,
    cached by file mtime. Returns (None, None) if the file/token is absent.

    The Claude Code CLI refreshes this file periodically (on user interaction
    or before expiry). The proxy READS it on each Anthropic-bound request;
    mtime-cache avoids re-parsing on every hit but picks up refreshes as
    soon as the CLI writes them.
    """
    try:
        st = _CREDS_PATH.stat()
    except OSError:
        return None, None
    if _token_cache["mtime"] == st.st_mtime:
        return _token_cache["value"], _token_cache["expires_at"]
    try:
        with _CREDS_PATH.open("r", encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, json.JSONDecodeError):
        return None, None
    token, expires_at = _extract_oauth_token(data)
    _token_cache["mtime"] = st.st_mtime
    _token_cache["value"] = token
    _token_cache["expires_at"] = expires_at
    return token, expires_at


# ---------------------------------------------------------------------------
# Upstream response-status tap (mika#1901)
#
# WHY: the reverse-proxy used to relay the upstream response as an opaque byte
# loop and then print `ALLOW <method> <path>` unconditionally. A 429, a 401, a
# 500 and a 200 all produced the same line — so on 2026-08-06 a pilot session
# that Anthropic was throttling looked, in the log, exactly like a healthy one.
# It stalled 606s, the guardrail killed it as an idle timeout, and establishing
# the real cause needed an instrumented copy of this file plus a host-side curl.
#
# The tap below reads the status line off the stream WITHOUT owning it: the
# relay writes each chunk to the client first and only then hands a copy to the
# accumulator. Nothing is buffered ahead of the client, so SSE timing is
# unchanged. Only the response HEAD is retained, capped, and only allowlisted
# header names are ever eligible for logging — a wildcard dump would eventually
# print an Authorization value after some upstream change.
# ---------------------------------------------------------------------------

_HEAD_TERMINATOR = b"\r\n\r\n"
RESPONSE_HEAD_CAP = 65536
# The trailing (?:[ \t]|$) keeps a still-arriving code from being misread: it
# matches a completed 3-digit code followed by the reason phrase, or one that
# ends the buffer, but not a prefix of a longer number.
_STATUS_LINE_RE = re.compile(rb"^HTTP/\d\.\d[ \t]+(\d{3})(?:[ \t]|$)", re.ASCII)
# 1xx is a preamble (100 Continue, 103 Early Hints), never the verdict.
_INTERIM_STATUS_CEILING = 200

# Quota metadata Anthropic returns alongside a throttle verdict. `request-id`
# is an opaque upstream correlation id — the 2026-08-06 investigation quoted
# one (req_011CdmbTL5FH62zfwP7ieMhu) and it is what a support thread asks for.
# Nothing here carries request or response content.
_QUOTA_HEADER_NAMES = frozenset({"retry-after", "request-id"})
_QUOTA_HEADER_PREFIX = "anthropic-ratelimit-"


class _ResponseHeadTap:
    """Bounded, passive accumulator for an upstream HTTP response head.

    Fed a copy of each relayed chunk. Stops accumulating once the head
    terminator arrives, so a long body costs nothing, and gives up entirely
    past `cap` so a malformed or hostile upstream cannot grow proxy memory
    per connection.
    """

    def __init__(self, cap: int = RESPONSE_HEAD_CAP) -> None:
        self._buf = bytearray()
        self._cap = cap
        self.complete = False
        self.overflowed = False
        # Stream offset of `self._buf[0]`. Only ever advanced by what is
        # deleted off the FRONT, so it stays exact across an arbitrary number
        # of discarded 1xx preambles.
        self._origin = 0
        # mika#2317 — number of stream bytes consumed up to and including the
        # terminator of the FINAL head, discarded 1xx preambles counted. The
        # body-framing tap needs it to know where the body starts inside the
        # very chunk that completed the head; this tap is the only object that
        # knows how many preamble bytes it threw away, so it is the one that
        # counts. None until the head completes (and forever on overflow).
        self.head_end_offset: int | None = None

    def feed(self, chunk: bytes) -> None:
        if self.complete or self.overflowed:
            return
        self._buf += chunk
        while True:
            idx = self._buf.find(_HEAD_TERMINATOR)
            if idx < 0:
                if len(self._buf) > self._cap:
                    self.overflowed = True
                    self._buf = bytearray()
                return
            status = _parse_status_line(bytes(self._buf[:idx]))
            if status is None or status >= _INTERIM_STATUS_CEILING:
                self.complete = True
                self.head_end_offset = self._origin + idx + len(_HEAD_TERMINATOR)
                del self._buf[idx:]  # keep the head, drop the body
                return
            # An interim 1xx head is a preamble, not the answer. Drop it and
            # keep reading, or the log would report `-> 100` and hide the real
            # verdict behind a status that merely looks like one.
            consumed = idx + len(_HEAD_TERMINATOR)
            del self._buf[:consumed]
            self._origin += consumed

    @property
    def head(self) -> bytes:
        """The response head, or b'' on overflow.

        Returns whatever has accumulated so far when the head is still open —
        the status line is usually readable well before the last header.
        """
        if self.overflowed:
            return b""
        idx = self._buf.find(_HEAD_TERMINATOR)
        return bytes(self._buf if idx < 0 else self._buf[:idx])


def _parse_status_line(head: bytes) -> int | None:
    """Integer status code from a response head, or None if not yet readable.

    None covers the cases the log must not report as a verdict: no bytes at
    all, a first line that is not a status line, and a status code that has not
    finished arriving.

    The first line is read whether or not a CRLF has terminated it yet. A
    response whose head is a bare status line with no headers is legal, and
    requiring the CRLF made the proxy call it `UPSTREAM_NO_RESPONSE` — claiming
    silence from an upstream that had in fact answered.
    """
    line = head.partition(b"\r\n")[0]
    match = _STATUS_LINE_RE.match(line)
    return int(match.group(1)) if match else None


def _select_quota_headers(head: bytes) -> list[tuple[str, str]]:
    """Allowlisted quota headers from a response head, in upstream order.

    Allowlist-driven by construction: a header this function does not name can
    never reach a log line, whatever the upstream starts returning.
    """
    selected: list[tuple[str, str]] = []
    for raw in head.split(b"\r\n")[1:]:  # [0] is the status line
        name, sep, value = raw.partition(b":")
        if not sep:
            continue
        decoded = name.decode("ascii", "replace").strip()
        lowered = decoded.lower()
        if lowered in _QUOTA_HEADER_NAMES or lowered.startswith(_QUOTA_HEADER_PREFIX):
            selected.append((decoded, value.decode("ascii", "replace").strip()))
    return selected


def _format_quota_headers(pairs: list[tuple[str, str]]) -> str:
    """Render selected headers as `name=value` pairs for one log line."""
    return " ".join(f"{name}={value}" for name, value in pairs)


# ---------------------------------------------------------------------------
# Response body framing (mika#2317)
#
# WHY: the relay loops on `up_reader.read()` until the UPSTREAM closes, so the
# duration of a turn is bounded by the upstream's connection policy, not by the
# length of its answer. mika#2313 made those two instants near-simultaneous by
# no longer forwarding the client's `Connection: keep-alive` — upstream now sees
# only our `Connection: close` and closes right after responding. That fix is
# correct and holds, but it rests on an upstream POLICY. An upstream that
# ignored `close` one day would reproduce mika#2313 exactly: the relay would
# wait out the ~360 s idle-timeout, the CLI's already-sent second request would
# sit unread, and the 5-min prompt-cache TTL would be blown on every turn.
#
# The end of the body is readable ON THE STREAM, so the relay can establish it
# itself. Below is the decoder that does; the relay returns the moment it says
# the body is over. Two properties govern every line of it:
#
#   * PASSIVE. It is fed a copy of bytes ALREADY written and drained to the
#     client (write-then-tap, the `_ResponseHeadTap` pattern). It retains
#     nothing, reorders nothing, rewrites nothing. It cannot truncate a
#     response by construction — it can only declare an end too early.
#   * ASYMMETRIC FAIL-SAFE. Declaring an end too early cuts a live LLM stream:
#     a lost turn, and downstream a partial answer that does not present itself
#     as partial. Failing to detect a real end costs nothing at all — the relay
#     reads to EOF, exactly as it did before this code existed. So anything
#     unprovable is `UNDETERMINED`, which IS today's behaviour.
#
# In particular the chunked terminator is NOT a substring. A body is a run of
# `<hex-size>\r\n<data>\r\n` closed by `0\r\n<trailers?>\r\n`, and the literal
# `0\r\n\r\n` can occur INSIDE chunk data — which here is arbitrary SSE JSON.
# Hence a state machine, not an `in chunk`.
# ---------------------------------------------------------------------------

_FRAMING_UNDETERMINED = "undetermined"
_FRAMING_NO_BODY = "no-body"
_FRAMING_LENGTH = "length"
_FRAMING_CHUNKED = "chunked"

# Statuses that carry no response body whatever the headers say.
_BODILESS_STATUSES = frozenset({204, 304})

_CHUNK_SIZE_RE = re.compile(rb"^[0-9A-Fa-f]{1,15}$", re.ASCII)
_DIGITS_RE = re.compile(rb"^\d+$", re.ASCII)


def _header_values(head: bytes, name: str) -> list[bytes]:
    """Every value of `name` in a response head, in upstream order.

    Returns one entry per occurrence of the header — the duplicates matter:
    two disagreeing `Content-Length` lines are a framing contradiction, and
    collapsing them here would hide it.
    """
    wanted = name.lower().encode("ascii")
    values: list[bytes] = []
    for raw in head.split(b"\r\n")[1:]:  # [0] is the status line
        key, sep, value = raw.partition(b":")
        if not sep:
            continue
        if key.strip().lower() == wanted:
            values.append(value.strip())
    return values


def _content_length_of(values: list[bytes]) -> int | None:
    """The single agreed `Content-Length`, or None when it is not provable.

    None on: a non-numeric token, an empty value, or two tokens that disagree
    (across duplicate headers or inside one comma list). RFC 9112 §6.3 permits
    a repeated identical value; anything else is a contradiction we decline to
    resolve rather than pick a side of.
    """
    tokens: list[bytes] = []
    for value in values:
        tokens.extend(part.strip() for part in value.split(b","))
    if not tokens:
        return None
    seen: set[int] = set()
    for token in tokens:
        if not _DIGITS_RE.match(token):
            return None
        seen.add(int(token))
    return seen.pop() if len(seen) == 1 else None


def _last_transfer_coding(values: list[bytes]) -> bytes | None:
    """The final coding of the `Transfer-Encoding` chain, lowercased.

    Only the LAST one decides the framing: `gzip, chunked` is chunked-framed,
    `chunked, gzip` is not framed at all (and is illegal, which is why it
    lands in `UNDETERMINED`).
    """
    codings: list[bytes] = []
    for value in values:
        for part in value.split(b","):
            token = part.split(b";", 1)[0].strip().lower()
            if token:
                codings.append(token)
    return codings[-1] if codings else None


def _classify_response_framing(head: bytes, method: str) -> tuple[str, int]:
    """Framing mode implied by a COMPLETE response head, and its length.

    Every branch that is not a proof returns `UNDETERMINED`; see the module
    comment above for why that asymmetry is the whole design.
    """
    status = _parse_status_line(head)
    if status is not None and (
        method.upper() == "HEAD" or status in _BODILESS_STATUSES
    ):
        # A HEAD response carries the `Content-Length` of the body it is NOT
        # sending. Without this branch the relay would wait for n bytes that
        # never come — fail-safe, but one line buys the real answer.
        return _FRAMING_NO_BODY, 0

    te_values = _header_values(head, "transfer-encoding")
    cl_values = _header_values(head, "content-length")

    if te_values and cl_values:
        # RFC 9112 §6.3 says follow chunked and ignore Content-Length, but this
        # pair is also the classic request-smuggling signature. We do not
        # arbitrate a self-contradicting response — and concluding nothing is
        # free here, since nothing is exactly what the relay did before.
        return _FRAMING_UNDETERMINED, 0
    if te_values:
        if _last_transfer_coding(te_values) == b"chunked":
            return _FRAMING_CHUNKED, 0
        return _FRAMING_UNDETERMINED, 0
    if cl_values:
        length = _content_length_of(cl_values)
        if length is None:
            return _FRAMING_UNDETERMINED, 0
        return _FRAMING_LENGTH, length
    # Neither header: the body ends at EOF. That is the RFC rule, not a
    # shortcoming — there is nothing to detect.
    return _FRAMING_UNDETERMINED, 0


class _ChunkedDecoder:
    """Strict `Transfer-Encoding: chunked` framing decoder.

    Consumes body bytes and reports when the terminating zero-size chunk and
    its trailer section have been fully read. Strict on purpose: a size that is
    not hexadecimal, a missing CRLF where one is required, or a size/trailer
    line longer than `cap` sets `failed`, and a failed decoder disarms the
    detection for the rest of the connection. It never guesses.
    """

    _SIZE = "size"
    _DATA = "data"
    _DATA_CRLF = "data-crlf"
    _TRAILERS = "trailers"

    def __init__(self, cap: int = RESPONSE_HEAD_CAP) -> None:
        self._buf = bytearray()
        self._cap = cap
        self._state = self._SIZE
        self._remaining = 0
        self.done = False
        self.failed = False

    def feed(self, data: bytes) -> None:
        if self.done or self.failed:
            return
        self._buf += data
        while not self.done and not self.failed:
            if self._state == self._DATA:
                take = min(self._remaining, len(self._buf))
                del self._buf[:take]
                self._remaining -= take
                if self._remaining:
                    return  # mid-chunk; wait for more bytes
                self._state = self._DATA_CRLF
                continue
            if self._state == self._DATA_CRLF:
                if len(self._buf) < 2:
                    return
                if self._buf[:2] != b"\r\n":
                    self.failed = True
                    return
                del self._buf[:2]
                self._state = self._SIZE
                continue
            # _SIZE or _TRAILERS: both need one CRLF-terminated line.
            idx = self._buf.find(b"\r\n")
            if idx < 0:
                if len(self._buf) > self._cap:
                    self.failed = True
                return
            line = bytes(self._buf[:idx])
            del self._buf[: idx + 2]
            if self._state == self._SIZE:
                size = _parse_chunk_size(line)
                if size is None:
                    self.failed = True
                    return
                if size == 0:
                    self._state = self._TRAILERS
                    continue
                self._remaining = size
                self._state = self._DATA
                continue
            if not line:  # empty line closes the trailer section
                self.done = True
                return
            # another trailer field; keep reading


def _parse_chunk_size(line: bytes) -> int | None:
    """Chunk size from a chunk-size line, or None when it is not one.

    Chunk extensions (`;name=value`) are dropped; the remainder must be pure
    hexadecimal with no surrounding whitespace, as RFC 9112 §7.1 requires.
    """
    token = line.split(b";", 1)[0]
    if not _CHUNK_SIZE_RE.match(token):
        return None
    return int(token, 16)


class _BodyFramingTap:
    """Passive detector for the end of a response BODY.

    Constructed from the final response head, then fed a copy of each body byte
    already relayed to the client. `done` flips exactly once, on proof. It has
    no other output and holds no bytes.
    """

    def __init__(self, head: bytes, method: str) -> None:
        self.mode, self._remaining = _classify_response_framing(head, method)
        self._decoder = (
            _ChunkedDecoder() if self.mode == _FRAMING_CHUNKED else None
        )
        # `Content-Length: 0` and a bodiless status both finish at the head.
        self.done = self.mode == _FRAMING_NO_BODY or (
            self.mode == _FRAMING_LENGTH and self._remaining == 0
        )

    @classmethod
    def undetermined(cls) -> "_BodyFramingTap":
        """A tap for a head that could not be read at all (overflow).

        Not the same as `_BodyFramingTap(b"", method)`: for a HEAD request that
        would classify as `NO_BODY`, and a head we never found the end of gives
        no idea where the body starts.
        """
        tap = cls.__new__(cls)
        tap.mode = _FRAMING_UNDETERMINED
        tap._remaining = 0
        tap._decoder = None
        tap.done = False
        return tap

    @property
    def determinate(self) -> bool:
        """Whether this tap can prove an end at all, for this connection."""
        return self.mode != _FRAMING_UNDETERMINED

    def feed(self, body: bytes) -> None:
        if self.done or self.mode == _FRAMING_UNDETERMINED:
            return
        if self.mode == _FRAMING_LENGTH:
            self._remaining -= len(body)
            if self._remaining <= 0:
                self.done = True
            return
        if self._decoder is not None:
            self._decoder.feed(body)
            if self._decoder.failed:
                # Unreadable framing disarms detection for the rest of this
                # connection rather than guessing where the body stops.
                self.mode = _FRAMING_UNDETERMINED
                self._decoder = None
            elif self._decoder.done:
                self.done = True


# Opt-in debug gate for benign, high-frequency egress events. Off by default;
# an operator sets MIKA_EGRESS_DEBUG=1 to see the aggregate. It gates ONLY the
# benign classes below — a real error is never gated, it always prints.
_EGRESS_DEBUG = os.environ.get("MIKA_EGRESS_DEBUG", "").strip().lower() not in (
    "", "0", "false", "no", "off",
)

# Running count of benign readiness probes: a peer that connected and closed
# without ever sending a CONNECT line. dispatch-lib.sh's
# `_pilot_egress_sock_connectable` and the sandbox's bounded --sandbox-tcp wait
# loop do exactly this before every dispatch to confirm the proxy is alive, so
# it is expected and benign. It used to reach the `except Exception` sink as
# `[egress] ERROR unknown: Connection lost` (the 400-to-a-gone-peer drain
# raised): 1045 of 2747 [egress] lines were this one non-event, and they were
# then misread as a broken transport during mika#2029 (mika#2042). Counted at
# debug, never cried as error.
_readiness_probe_count = 0


def _note_readiness_probe() -> None:
    """Record one benign readiness probe (connect + close, no CONNECT line).

    Emits at most a debug-level aggregate line — the running count, not one
    line per occurrence — and only when MIKA_EGRESS_DEBUG is set. Default is
    silence. Never emits ERROR: that is the whole point of mika#2042.
    """
    global _readiness_probe_count
    _readiness_probe_count += 1
    if _EGRESS_DEBUG:
        _log(
            "[egress] DEBUG readiness-probe (connect+close, no CONNECT) "
            f"count={_readiness_probe_count}"
        )


# How each relay ended, counted per class (mika#2317). A net that never says it
# served is indistinguishable from a no-op (mika#2156, mika#2249) — but be exact
# about what is observable. "Upstream held the connection" versus "the EOF had
# not surfaced yet" is NOT decidable for free: after our last read, a false
# `at_eof()` proves nothing, it is a race, and any reliable distinction costs a
# wait — which is precisely the delay this work removes. So no per-request
# "the net served" verdict is built; that line would be noise AND wrong.
#
# What IS decidable is the termination class, and the one carrying information
# is `undetermined`: non-zero, it names requests this work protects not at all,
# which is a fact an operator can act on. Exact mirror of
# `pilot_stall_signal_unavailable` (mika#2277) — a net must say who it cannot see.
_RELAY_BODY_END = "body-end"
_RELAY_EOF = "eof"
_RELAY_UNDETERMINED = "undetermined"
_relay_termination_counts = {
    _RELAY_BODY_END: 0,
    _RELAY_EOF: 0,
    _RELAY_UNDETERMINED: 0,
}


def _note_relay_termination(kind: str) -> None:
    """Record how one relayed response ended.

    Same discipline as `_note_readiness_probe`: silent by default, an aggregate
    of the running counts under MIKA_EGRESS_DEBUG, never an error.
    """
    _relay_termination_counts[kind] = _relay_termination_counts.get(kind, 0) + 1
    if _EGRESS_DEBUG:
        detail = " ".join(
            f"{name}={count}"
            for name, count in sorted(_relay_termination_counts.items())
        )
        _log(f"[anthropic-proxy] DEBUG relay-termination {detail}")


def _log_upstream_outcome(
    method: str,
    path: str,
    status: int | None,
    quota_headers: list[tuple[str, str]],
) -> None:
    """Emit the operator-facing verdict for one forwarded Anthropic request.

    `ALLOW` keeps its meaning — the egress allowlist permitted the call — and
    now carries what the upstream answered, so 401 / 429 / 5xx stop hiding
    behind a line that reads like success. A throttle also gets its own
    greppable class line: `RATE_LIMITED` is the one word an operator needs to
    reach the 2026-08-06 conclusion without writing a probe.

    A status of None means the upstream closed without ever answering. That is
    a distinct outcome, not an allowed call, and is reported as such.
    """
    if status is None:
        _log(f"[anthropic-proxy] UPSTREAM_NO_RESPONSE {method} {path}")
        return
    _log(f"[anthropic-proxy] ALLOW {method} {path} -> {status}")
    if status == 429:
        detail = _format_quota_headers(quota_headers)
        line = f"[anthropic-proxy] RATE_LIMITED {method} {path}"
        _log(f"{line} {detail}" if detail else line)


async def _relay_response_with_status_tap(
    up_reader: asyncio.StreamReader,
    writer: asyncio.StreamWriter,
    method: str,
    path: str,
) -> None:
    """Stream upstream → client, logging the verdict exactly once.

    Two properties this function owns:

    **Write-then-tap.** The client gets every chunk at the moment it arrives,
    exactly as before this tap existed. The accumulator only ever sees a copy
    of bytes already sent.

    **Log at the head, not at the end.** The verdict is emitted as soon as the
    response head is complete, and the `finally` guarantees a line even when
    the relay dies mid-body. Logging only after a clean EOF loses the verdict
    in precisely the shape this instrumentation exists for: upstream answers
    429, the pilot stalls, the guardrail kills it, the client socket closes,
    `drain()` raises — and the proxy prints nothing at all.

    **Return on proof of body end, not on upstream EOF** (mika#2317). Once the
    framing tap says the body is over, this returns; the callers' `finally`
    blocks then close upstream and client. A turn can therefore never outlast
    the response itself, even against an upstream that keeps the connection
    open. Anything the framing cannot prove keeps the previous behaviour — read
    until the upstream closes.
    """
    tap = _ResponseHeadTap()
    framing: _BodyFramingTap | None = None
    reported = False
    offset = 0
    terminated_on_body_end = False
    try:
        while True:
            chunk = await up_reader.read(BUFFER_SIZE)
            if not chunk:
                break
            writer.write(chunk)
            await writer.drain()
            chunk_start = offset
            offset += len(chunk)

            if framing is None:
                tap.feed(chunk)
                if tap.complete:
                    _log_upstream_outcome(
                        method, path,
                        _parse_status_line(tap.head),
                        _select_quota_headers(tap.head),
                    )
                    reported = True
                    framing = _BodyFramingTap(tap.head, method)
                    # The chunk that completed the head usually carries the
                    # first body bytes too. Hand the tap only that tail.
                    body_start = tap.head_end_offset
                    if body_start is not None and body_start < offset:
                        framing.feed(chunk[max(0, body_start - chunk_start):])
                elif tap.overflowed:
                    # The head never ended within the cap, so where the body
                    # starts is unknown. Stay on the EOF path, and leave the
                    # verdict to the `finally` exactly as before.
                    framing = _BodyFramingTap.undetermined()
            else:
                framing.feed(chunk)

            if framing is not None and framing.done:
                terminated_on_body_end = True
                break
    finally:
        if not reported:
            head = tap.head
            _log_upstream_outcome(
                method, path,
                _parse_status_line(head),
                _select_quota_headers(head),
            )
        if terminated_on_body_end:
            _note_relay_termination(_RELAY_BODY_END)
        elif framing is not None and framing.determinate:
            _note_relay_termination(_RELAY_EOF)
        else:
            _note_relay_termination(_RELAY_UNDETERMINED)


async def pipe_bytes(reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
    """Forward reader → writer until either side closes. Silent on error."""
    try:
        while True:
            data = await reader.read(BUFFER_SIZE)
            if not data:
                break
            writer.write(data)
            await writer.drain()
    except (ConnectionResetError, BrokenPipeError, asyncio.CancelledError, OSError):
        pass
    finally:
        try:
            writer.close()
        except OSError:
            pass


# Client request headers the relay MUST NOT forward upstream (mika#2313).
# host/authorization/x-api-key/proxy-authorization are re-written by the relay.
# connection/keep-alive/proxy-connection are hop-by-hop: forwarding the client's
# `Connection: keep-alive` upstream (alongside our injected `Connection: close`)
# left TWO Connection headers; upstream honoured keep-alive and held the TLS open,
# so the relay (one request per connection) looped on up_reader.read() until
# upstream's ~360 s idle-timeout — never closing the client, so the CLI's
# already-sent 2nd request sat unread ~358 s per turn. That hang exceeded the
# 5-min prompt-cache TTL, so every turn re-created 100-250k tokens (the real
# "cache_read=0", NOT ~/.claude.json). Stripping these leaves ONLY our
# `Connection: close` upstream → upstream closes right after the response →
# the relay returns promptly, the response carries Connection: close, and the
# client does not reuse the connection. Module-level so the guard is testable
# (test-pilot-egress-keepalive.py).
_CLIENT_HEADER_DROP_RE = re.compile(
    rb"^(host|authorization|x-api-key|proxy-authorization"
    rb"|connection|keep-alive|proxy-connection)\s*:",
    re.IGNORECASE,
)


async def handle_anthropic_reverse_proxy(
    reader: asyncio.StreamReader,
    writer: asyncio.StreamWriter,
    request: bytes,
    method: bytes,
    path: bytes,
) -> None:
    """Q3 host-side auth injection (Voie A — subscription OAuth).

    Sandbox client sends an HTTP request to <method> /anthropic-proxy/<rest>.
    We strip the prefix, rewrite Host and Authorization headers with the
    subscription OAuth access token from ~/.claude/.credentials.json
    (host-side, never crosses sandbox boundary), open TLS to
    api.anthropic.com:443, forward request, and stream response back.

    Refresh: delegated to the local Claude Code CLI. When the CLI refreshes
    its token, the file mtime changes and the proxy picks up the new value
    on the next request. If expired without a refresh (marathon-nights with
    no CLI activity), Anthropic responds 401 → pilot fails visibly → cron
    keep-warm covers this case (see docs/solutions/).
    """
    token, expires_at = read_subscription_token()
    if token is None:
        body = (
            f"mika-pilot-egress: subscription OAuth token not found in "
            f"{_CREDS_PATH}. Vincent must be logged in to Claude Code on "
            f"the host for the pilot to authenticate.\n"
        ).encode("utf-8")
        writer.write(
            b"HTTP/1.1 503 Service Unavailable\r\n"
            b"Content-Type: text/plain; charset=utf-8\r\n"
            b"Content-Length: " + str(len(body)).encode() + b"\r\n"
            b"Connection: close\r\n"
            b"\r\n" + body
        )
        await writer.drain()
        _log(f"[anthropic-proxy] DENY no-token path={path.decode('ascii', 'replace')}")
        return
    # Soft-warn if the token appears expired — Anthropic will 401 anyway,
    # this makes debugging easier from the proxy log.
    if expires_at is not None and expires_at < time.time():
        _log(
            f"[anthropic-proxy] WARN token appears expired "
            f"({int(time.time() - expires_at)}s ago) — Anthropic will 401. "
            f"Refresh via a Claude Code CLI call on the host."
        )

    # Split request into request-line + headers. body follows blank line.
    try:
        head, _sep, _ = request.partition(b"\r\n\r\n")
    except Exception:
        writer.write(b"HTTP/1.1 400 Bad Request\r\n\r\n")
        await writer.drain()
        return
    lines = head.split(b"\r\n")
    header_lines = lines[1:]  # skip request line
    new_path = path[len(ANTHROPIC_PROXY_PATH_PREFIX.encode("ascii")):]
    if not new_path or not new_path.startswith(b"/"):
        new_path = b"/" + new_path
    # Drop Host, Authorization, X-API-Key, X-Api-Key from client headers —
    # we re-write them. Drop Proxy-Authorization defensively. Preserve
    # everything else (Content-Type, Content-Length, Transfer-Encoding,
    # Accept, User-Agent, anthropic-version, anthropic-beta, etc.).
    drop_re = _CLIENT_HEADER_DROP_RE  # mika#2313 — see module constant
    filtered_headers = [h for h in header_lines if not drop_re.match(h)]
    # Detect body length. Support Content-Length (fixed) and
    # Transfer-Encoding: chunked (streaming).
    content_length = 0
    is_chunked = False
    for h in filtered_headers:
        if re.match(rb"^content-length\s*:", h, re.IGNORECASE):
            try:
                content_length = int(h.split(b":", 1)[1].strip())
            except (ValueError, IndexError):
                content_length = 0
        elif re.match(rb"^transfer-encoding\s*:.*chunked", h, re.IGNORECASE):
            is_chunked = True
    # Build new request line + injected headers.
    new_request = (
        method + b" " + new_path + b" HTTP/1.1\r\n"
        + b"Host: " + ANTHROPIC_UPSTREAM_HOST.encode("ascii") + b"\r\n"
        + b"Authorization: Bearer " + token.encode("ascii") + b"\r\n"
        + b"Connection: close\r\n"  # force one-shot, avoid keepalive complexity
        + b"\r\n".join(filtered_headers)
        + b"\r\n\r\n"
    )
    # Open TLS upstream.
    try:
        ssl_ctx = ssl.create_default_context()
        up_reader, up_writer = await asyncio.wait_for(
            asyncio.open_connection(
                ANTHROPIC_UPSTREAM_HOST, ANTHROPIC_UPSTREAM_PORT,
                ssl=ssl_ctx, server_hostname=ANTHROPIC_UPSTREAM_HOST,
            ),
            timeout=15.0,
        )
    except (asyncio.TimeoutError, OSError, ssl.SSLError) as exc:
        writer.write(b"HTTP/1.1 502 Bad Gateway\r\n\r\n")
        await writer.drain()
        _log(f"[anthropic-proxy] UPSTREAM_FAIL: {exc}")
        return

    try:
        # Send request head.
        up_writer.write(new_request)
        await up_writer.drain()
        # Forward request body from client → upstream.
        if is_chunked:
            # Stream chunked body verbatim until 0-length chunk terminator.
            while True:
                chunk = await reader.read(BUFFER_SIZE)
                if not chunk:
                    break
                up_writer.write(chunk)
                await up_writer.drain()
                if b"0\r\n\r\n" in chunk:
                    break
        elif content_length > 0:
            remaining = content_length
            while remaining > 0:
                chunk = await reader.read(min(BUFFER_SIZE, remaining))
                if not chunk:
                    break
                up_writer.write(chunk)
                await up_writer.drain()
                remaining -= len(chunk)
        # Stream response upstream → client until the response BODY ends
        # (mika#2317) or, when its framing is not provable, until upstream
        # closes. The status line is read off the stream on the way past and
        # the verdict logged (mika#1901). The taps never hold a byte back and
        # the verdict is logged exactly once — see
        # _relay_response_with_status_tap. Returning here reaches the `finally`
        # below (up_writer.close()) and, one frame up, handle_host_client's own
        # `finally` (writer.close()) — so both ends close on body end, which is
        # what the ticket asks for; no extra close is needed here.
        await _relay_response_with_status_tap(
            up_reader, writer,
            method.decode("ascii"),
            new_path.decode("ascii", "replace"),
        )
    finally:
        try:
            up_writer.close()
        except OSError:
            pass


async def handle_host_client(
    reader: asyncio.StreamReader,
    writer: asyncio.StreamWriter,
) -> None:
    """Host-side handler: dispatch by request-line to CONNECT or reverse-proxy."""
    peer = "unknown"
    try:
        # Read request line + headers (up to blank line).
        try:
            request = await asyncio.wait_for(
                reader.readuntil(b"\r\n\r\n"), timeout=10.0
            )
        except asyncio.IncompleteReadError as exc:
            # A peer that closed before sending a single request byte is the
            # readiness/availability probe, not a transport failure:
            # dispatch-lib.sh's `_pilot_egress_sock_connectable` (and the
            # sandbox's bounded --sandbox-tcp wait loop) open the socket and
            # close it, WITHOUT ever sending a CONNECT line, before every
            # dispatch. `peer` is still "unknown" here for that very reason —
            # nothing was read to name. Answering a peer that is already gone
            # is what raised `Connection lost` into the `except Exception` sink
            # below and cried ERROR 1045 times (mika#2042). Count it; stay
            # silent to the wire.
            if not exc.partial:
                _note_readiness_probe()
                return
            # Bytes arrived and the stream then truncated mid-request: a real
            # malformed request, not the probe. Answer it; a reset while doing
            # so still surfaces as ERROR below (anti-vacuity).
            writer.write(b"HTTP/1.1 400 Bad Request\r\n\r\n")
            await writer.drain()
            return
        except asyncio.TimeoutError:
            writer.write(b"HTTP/1.1 400 Bad Request\r\n\r\n")
            await writer.drain()
            return

        # Dispatch: CONNECT vs anthropic-proxy HTTP reverse-proxy.
        anthropic_match = ANTHROPIC_METHOD_RE.match(request)
        if anthropic_match:
            method = anthropic_match.group(1)
            path = anthropic_match.group(2)
            await handle_anthropic_reverse_proxy(
                reader, writer, request, method, path,
            )
            return

        match = CONNECT_RE.match(request)
        if not match:
            writer.write(b"HTTP/1.1 400 Bad Request\r\n\r\n")
            await writer.drain()
            return

        host = match.group(1).decode("ascii", errors="replace")
        port = int(match.group(2))
        peer = f"{host}:{port}"

        # γ auth-injection tunnel (2026-08-05, Vincent-authorized): CONNECT
        # to api.anthropic.com is chained to the local mitmdump daemon on
        # 127.0.0.1:MITM_UPSTREAM_PORT rather than tunneled to Anthropic
        # directly. mitmdump handles TLS with its own CA (sandbox trusts it
        # via NODE_EXTRA_CA_CERTS bind — dispatch-lib.sh) and an addon
        # rewrites the Authorization header before upstream forwarding.
        # See scripts/mika-pilot-anthropic-auth-addon.py for the addon.
        if host in MITM_FORWARD_HOSTS:
            try:
                up_reader, up_writer = await asyncio.wait_for(
                    asyncio.open_connection("127.0.0.1", MITM_UPSTREAM_PORT),
                    timeout=5.0,
                )
            except (asyncio.TimeoutError, OSError) as exc:
                writer.write(b"HTTP/1.1 502 Bad Gateway\r\n\r\n")
                await writer.drain()
                _log(f"[mitm-forward] MITMDUMP_DOWN {peer}: {exc}")
                return
            up_writer.write(request)
            await up_writer.drain()
            _log(f"[mitm-forward] {peer} → mitmdump")
            await asyncio.gather(
                pipe_bytes(reader, up_writer),
                pipe_bytes(up_reader, writer),
                return_exceptions=True,
            )
            return

        if host not in HOST_ALLOWLIST:
            body = (
                f"host '{host}' not in mika-pilot egress allowlist"
                "\n"
            ).encode("utf-8")
            writer.write(
                b"HTTP/1.1 403 Forbidden\r\n"
                b"Content-Type: text/plain; charset=utf-8\r\n"
                b"Content-Length: " + str(len(body)).encode() + b"\r\n"
                b"Connection: close\r\n"
                b"\r\n"
                + body
            )
            await writer.drain()
            _log(f"[egress] DENY {peer}")
            return

        # Upstream connect. Bounded timeout so a dead upstream can't wedge.
        try:
            up_reader, up_writer = await asyncio.wait_for(
                asyncio.open_connection(host, port), timeout=15.0
            )
        except (asyncio.TimeoutError, OSError) as exc:
            writer.write(b"HTTP/1.1 502 Bad Gateway\r\n\r\n")
            await writer.drain()
            _log(f"[egress] FAIL {peer}: {exc}")
            return

        writer.write(b"HTTP/1.1 200 Connection Established\r\n\r\n")
        await writer.drain()
        _log(f"[egress] ALLOW {peer}")

        # Bidirectional relay. Either side closing tears down both.
        await asyncio.gather(
            pipe_bytes(reader, up_writer),
            pipe_bytes(up_reader, writer),
            return_exceptions=True,
        )
    except Exception as exc:  # noqa: BLE001 — proxy must not crash on bad clients
        _log(f"[egress] ERROR {peer}: {exc}")
    finally:
        try:
            writer.close()
        except OSError:
            pass


async def handle_sandbox_client(
    reader: asyncio.StreamReader,
    writer: asyncio.StreamWriter,
    unix_sock_path: str,
) -> None:
    """Sandbox-side handler: verbatim pipe TCP client ↔ unix socket to host."""
    try:
        try:
            up_reader, up_writer = await asyncio.wait_for(
                asyncio.open_unix_connection(unix_sock_path), timeout=5.0
            )
        except (asyncio.TimeoutError, OSError):
            writer.write(b"HTTP/1.1 502 Bad Gateway\r\n\r\n")
            await writer.drain()
            return
        await asyncio.gather(
            pipe_bytes(reader, up_writer),
            pipe_bytes(up_reader, writer),
            return_exceptions=True,
        )
    finally:
        try:
            writer.close()
        except OSError:
            pass


async def run_host_mode(unix_sock_path: str) -> None:
    sock_path = Path(unix_sock_path)

    # --- Pre-bind observability (mika#2051) --------------------------------
    # On 2026-08-29 two proxies died between exec and bind() and left NOTHING
    # in the log, though dispatch-lib captures stderr (`nohup ... 2>&1`). A
    # Python exception would have printed a traceback there, so a *silent*
    # pre-bind death is a signal with its default disposition, not a raise.
    # And the graceful SIGTERM/SIGINT handlers further down are installed only
    # AFTER bind: throughout startup the process carried the default
    # dispositions, so a SIGTERM in that window terminated it mutely -- the
    # very "the one that took the proxy down on 2026-08-29" the shutdown block
    # names. This closes that blind window at the source: announce arrival so
    # the log shows the proxy reached its own main, and arm early handlers
    # that NAME a pre-bind signal instead of dying without a word.
    loop = asyncio.get_running_loop()

    def _abort_on_startup_signal(signum: int) -> None:
        # A catchable signal reached us before bind() completed. Name it, then
        # exit hard -- we own no socket to unwind yet. A SIGKILL / OOM-kill
        # cannot be caught, so on the next incident its signature is this
        # line's ABSENCE while the `.begin` breadcrumb is present: begin + no
        # `.signalled` + no `listening` == uncatchable kill (SIGKILL/OOM);
        # begin + `.signalled` == a SIGTERM/SIGINT that landed during startup.
        # Routed through `_log` so it carries the timestamp every operator-log
        # line must (mika#2030): `_log` stays the sole stderr emitter.
        _log(
            f"[egress] pilot_egress_startup.signalled "
            f"{signal.Signals(signum).name} before bind on {sock_path} "
            f"(pid {os.getpid()}) -- aborting startup"
        )
        os._exit(3)

    for _startup_sig in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(_startup_sig, _abort_on_startup_signal, _startup_sig)

    # Emitted only AFTER the early handlers are armed, so this line doubles as
    # proof the pre-bind window is now guarded: a signal arriving from here on
    # is named by `_abort_on_startup_signal`, not swallowed by a default kill.
    # Through `_log` (the sole stderr emitter) so it is timestamped like every
    # other operator-log line (mika#2030) and a date grep composes across them.
    _log(
        f"[egress] pilot_egress_startup.begin pid={os.getpid()} "
        f"binding {sock_path}"
    )

    # Test-only seam (mika#2051): park deterministically inside the pre-bind
    # window -- still under the early handlers, before bind -- so the
    # regression test can land a signal in exactly the window the incident
    # occupied. Never set in production (the launcher does not export it).
    _prebind_barrier = os.environ.get("_MIKA_EGRESS_PREBIND_TEST_BARRIER")
    if _prebind_barrier:
        await asyncio.sleep(float(_prebind_barrier))

    # Remove stale socket if present.
    if sock_path.exists():
        try:
            if stat.S_ISSOCK(sock_path.stat().st_mode):
                sock_path.unlink()
            else:
                # These fatal-startup diagnostics reach the same log file as the
                # rest (stderr → pilot-egress-proxy.log), so they carry the
                # mika#2030 timestamp too — a bare `sys.exit(msg)` would land an
                # un-stamped line in the middle of a stamped log.
                _log(f"[egress] FATAL refusing to unlink non-socket: {sock_path}")
                sys.exit(1)
        except OSError as exc:
            _log(f"[egress] FATAL stale-socket cleanup failed: {exc}")
            sys.exit(1)

    server = await asyncio.start_unix_server(handle_host_client, str(sock_path))
    # World-writable so the sandbox (running as same uid, but env-cleared) can
    # still connect through the bwrap-mounted socket path.
    sock_path.chmod(0o666)

    # Remember the inode we just bound. Shutdown uses it to tell OUR socket from
    # a successor proxy's: `is_socket()` is equally true of someone else's live
    # path, and deleting that leaves a running proxy unreachable.
    try:
        bound_ino = os.stat(sock_path).st_ino
    except OSError:
        bound_ino = None
    _log(
        f"[egress] host-unix listening on {sock_path} (allowlist: "
        f"{len(HOST_ALLOWLIST)} hosts)"
    )
    # A kill does not unlink a unix socket. Without this, SIGTERM -- the default
    # kill, and the one that took the proxy down on 2026-08-29 -- leaves the path
    # behind as an orphan: a file that still satisfies `[ -S ]` and refuses
    # connect(), which is exactly what armed the launcher's broken guard in
    # dispatch-lib (mika#2041). SIGINT already unwound cleanly through
    # KeyboardInterrupt; routing both through the same stop future makes the two
    # signals behave alike instead of by accident.
    #
    # These REPLACE the early pre-bind handlers armed at the top of this
    # function (add_signal_handler is last-writer-wins per signal): now that a
    # socket exists, a SIGTERM must unwind gracefully and unlink it rather than
    # abort hard.
    stop = loop.create_future()

    def _request_stop() -> None:
        if not stop.done():
            stop.set_result(None)

    for sig in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(sig, _request_stop)

    try:
        await stop
    finally:
        # `close()`, and NOT `async with server` / `await server.wait_closed()`:
        # since CPython 3.12.1 wait_closed() blocks until every live client
        # handler detaches, and a CONNECT tunnel lasts as long as the pilot
        # session holding it. Measured: with one established tunnel, SIGTERM
        # left the proxy running past 15s. An operator whose kill does nothing
        # reaches for `kill -9` -- which is precisely how the orphaned socket
        # this whole change exists to prevent gets made.
        server.close()

        # asyncio removes the socket file itself only from 3.13, where
        # create_unix_server grew `cleanup_socket` and the inode bookkeeping
        # behind it. Older interpreters never unlink -- measured on 3.12 and on
        # CI's ubuntu-22.04/3.10, where every shutdown path left the socket
        # behind. So do it here, with the same inode comparison 3.13+ uses, and
        # tolerate the file already being gone when the runtime got there first.
        if bound_ino is not None:
            try:
                if os.stat(sock_path).st_ino == bound_ino:
                    os.unlink(sock_path)
            except FileNotFoundError:
                pass
            except OSError:
                pass


async def run_sandbox_mode(port: int, unix_sock_path: str) -> None:
    server = await asyncio.start_server(
        lambda r, w: handle_sandbox_client(r, w, unix_sock_path),
        host="127.0.0.1",
        port=port,
    )
    _log(f"[egress-shim] tcp 127.0.0.1:{port} → {unix_sock_path}")
    async with server:
        await server.serve_forever()


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="mika-pilot-egress-proxy",
        description=__doc__.split("\n", 1)[0],
    )
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument(
        "--host-unix",
        action="store_true",
        help="Run as host-side unix socket proxy with hostname allowlist",
    )
    mode.add_argument(
        "--sandbox-tcp",
        type=int,
        metavar="PORT",
        help="Run as sandbox-side TCP→unix bridge on 127.0.0.1:PORT",
    )
    parser.add_argument(
        "--socket",
        default=DEFAULT_UNIX_SOCK,
        help=f"Unix socket path (default: {DEFAULT_UNIX_SOCK})",
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    try:
        if args.host_unix:
            asyncio.run(run_host_mode(args.socket))
        else:
            asyncio.run(run_sandbox_mode(args.sandbox_tcp, args.socket))
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
