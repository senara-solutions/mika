#!/usr/bin/env python3
"""Emit a sandbox-safe ~/.claude.json for the contained pilot (mika#2313).

The bwrap containment (mika#2108) blanks /home with `--tmpfs /home` and never
binds ~/.claude.json. Without it the sandboxed CLI runs without its cached
feature flags (GrowthBook), which govern the prompt-cache `cache_control`
strategy — so every turn re-creates 100-250k tokens and reads 0 from cache
(cache_read=0), driving 355s turns and burning the subscription. Providing a
claude.json restored cache_read>0 (measured: 0 -> 31226).

Security (mika#2039): the real ~/.claude.json carries account/OAuth state
(oauthAccount, userID, machineID, bridge*). This emitter is an ALLOWLIST: only
feature-flag / cache keys pass; everything else — including any key added in the
future — is dropped. Nothing secret can reach the sandbox by construction.

Usage: mika-pilot-sanitize-claude-json [SOURCE] > sanitized.json
       (SOURCE defaults to $HOME/.claude.json; missing source => `{}`)
"""
import json
import os
import sys

# Feature-flag / cache keys only. These gate the CLI's prompt-cache behaviour
# and mark the profile as "not first launch". NEVER add an account/credential
# key here (oauthAccount, userID, machineID, bridge*, *token*, *Account*).
ALLOWLIST = frozenset({
    "hasCompletedOnboarding",
    "firstStartTime",
    "numStartups",
    "migrationVersion",
    "installMethod",
    "autoUpdates",
    "lastOnboardingVersion",
    "cachedGrowthBookFeatures",
    "cachedGrowthBookFeaturesAt",
    "cachedExperimentFeatures",
    "cachedExperimentData",
    "modelAccessCache",
    "additionalModelOptionsCache",
    "additionalModelCostsCache",
    "additionalModelOptionsAnsweredAt",
})

def sanitize(source: dict) -> dict:
    # Key-level allowlist IS the security boundary (mika#2039): only these
    # feature-flag / cache keys pass, so account/credential keys (oauthAccount,
    # userID, machineID, bridge*, *token*) never reach the sandbox — including
    # any key added to ~/.claude.json in the future. Values are copied intact;
    # feature-flag NAMES legitimately contain words like "oauth" (flag keys such
    # as tengu_mcp_local_oauth_blocked_hosts), so no value-substring filtering
    # here — that would drop cachedGrowthBookFeatures, the very key that governs
    # the prompt-cache strategy. `test-pilot-claude-json-sanitized.sh` asserts
    # the emitted output carries no credential-SHAPED value (sk-ant-, JWT).
    return {key: source[key] for key in ALLOWLIST if key in source}


def main() -> int:
    src_path = sys.argv[1] if len(sys.argv) > 1 else os.path.expanduser("~/.claude.json")
    try:
        with open(src_path, encoding="utf-8") as fh:
            source = json.load(fh)
    except (FileNotFoundError, json.JSONDecodeError):
        source = {}
    if not isinstance(source, dict):
        source = {}
    json.dump(sanitize(source), sys.stdout)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
