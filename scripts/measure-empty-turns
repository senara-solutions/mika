#!/usr/bin/env bash
# measure-empty-turns — how often does a mika agent's CONTINUATION turn finish
# having produced nothing, and is that the mika#1910 class or one of its three
# look-alikes?
#
# THE PROPERTY, not a list of greps. mika#1950 measured axis A (claude-pilot
# sessions) and left axis B — the GLM half, the turns of `mika-dev` — to an
# operator gesture written as two `grep | jq` that DUMP lines without defining a
# predicate: the operator receives a pipe and has to invent the rule on the
# spot. This script is that rule, in one command anybody can re-run.
#
# WHERE THE CLASS LANDS IN THE ENGINE. The ticket describes 30 turns burnt then
# an empty final message. Translated into mika's architecture: `max_steps` (20)
# exhausted -> `LoopResult::MaxStepsExceeded` -> `attempt_continuation_turn`
# (tools disabled, budget clamped) -> if that turn returns nothing, the engine
# serves `EMPTY_RESPONSE_FALLBACK`, literally "Done."
# (`crates/mika-agent/src/agent_loop/mod.rs`). The terminal symptom of mika#1910
# therefore lives on the CONTINUATION turn, and nowhere else. That is the line
# this script reads, and the only one.
#
# THE TRAP THIS SCRIPT IS BUILT AROUND — and it is worse than its sibling's.
# Until mika#1910 U1, `llm_calls.response_text` was NULL on the continuation row
# **100% of the time, successes included**: `save_continuation_llm_call` passed
# `None, None` on every branch. Three distinct populations share that NULL:
#
#   (a) rows older than schema v31   — the column did not exist
#   (b) rows of a call that errored  — no response exists to measure
#   (c) EVERY continuation row       — the instrumentation gap itself
#
# A predicate reading emptiness as "the value is absent" would count all three,
# with a false-positive rate of 100% on exactly the population of interest. So
# the measure is NOT derived from the absence of a value: it reads
# `response_chars`, a value mika#1910 U1 POSES on the ungated `turn_usage` line.
# `null` there means "not measured"; `0` means "measured, and it produced
# nothing" (the mika#2331 rule, one struct away from where it is written).
#
# THE WIRE FORM OF `response_chars` IS A DEBUG STRING, and this is derived from
# the producer rather than guessed. `emit_turn_usage` writes
# `response_chars = ?fields.response_chars` — the `?` sigil, chosen so the
# null/value distinction survives — and `tracing_subscriber`'s JSON layer
# serializes a `record_debug` field as a JSON *string*. On disk:
#
#     "response_chars":"Some(240)"   "response_chars":"Some(0)"   "response_chars":"None"
#
# A script expecting a JSON number would read every line as unmeasured and
# report ZERO occurrences of the class — a false green on precisely the
# population the ticket is about. A bare JSON number is accepted too, so a
# future formatter change degrades to correctness rather than to silence.
#
# THE UNIT IS THE TURN, AND THE KEY IS `trace_id` — NEVER `session_id`.
# `run_agent` mints one `trace_id` per invocation, and a session contains as
# many as it has turns. A `mika-dev` session whose turns exhaust `max_steps`
# twice legitimately carries TWO continuation lines; an analyzer deduplicating
# by session would under-count exactly the sessions where the class shows up
# most. A `trace_id` with no continuation line never reached `max_steps` and is
# NOT in the population — it is a normal turn, not an empty one.
#
# RULE 0, AND WHY IT IS NOT PARANOIA. At most one continuation line per turn is
# a guarantee of the ENGINE (three mutually exclusive call sites of
# `attempt_continuation_turn`, one loop exit per invocation), not of the wire
# format: `params.trace_id` is supplied by the caller, so nothing in the type
# forbids reusing one. A `trace_id` carrying more than one continuation line is
# therefore classed `undetermined` and counted under `duplicate_continuation` —
# never two `empty_response` (which would inflate the class by 2x on exactly the
# population of interest), never a silent pick of the first or the last (which
# would absorb the anomaly into a healthy-looking number). Expected regime:
# zero. Any occurrence names a caller reusing a `trace_id`, which is a defect
# upstream of the measurement and not a setting of the analyzer.
#
# THE PREDICATE, IN ORDER. The order is load-bearing:
#
#   0. more than one continuation line for the trace_id -> undetermined
#   1. status == "error"                                -> error        (mika#2357)
#   2. response_chars null / absent / unreadable        -> undetermined (the R5 trap)
#   3. MaxTokens AND output_tokens > 0 AND chars == 0   -> reasoning_budget_exhausted (mika#1665)
#   4. response_chars == 0                              -> empty_response  ** THE CLASS **
#   5. response_chars > 0                               -> produced
#
# Swapping 2 and 4 makes the class false on every line written before mika#1910
# was deployed; swapping 1 and 4 counts a glm-5.3 population (mika#2357: status
# `error`, `input_tokens` 0) under a glm-5.2 ticket. Rule 3 is not re-derived
# here: it is `calibration::failure::classify_failure`'s, whose test pins the
# agreement of its two consumers so two spellings cannot split one population.
#
# NOTE ON `status == "timeout"`. The continuation deadline-clamp arm writes
# `status = "timeout"` and `response_chars = null`, so it falls to rule 2 and
# reads `undetermined` — correct: the clamp cut the call, nothing came back to
# measure. It is deliberately NOT folded into rule 1, whose population is the
# mika#2357 family and must stay countable on its own.
#
# PRE-DEPLOY LINES CLASSIFY THEMSELVES, with no allowlist and no hard-coded
# date. Lines emitted before mika#1910 U1 carry no `response_chars` field at
# all, so rule 2 renders them `undetermined` BY CONSTRUCTION. The property
# self-cleans as the window advances; no historical line is rewritten.
#
# FAIL-SAFE, ALWAYS TOWARD `undetermined`. An absent field, an unreadable value,
# an invalid JSON line, a missing `trace_id` — each renders `undetermined`,
# never `empty_response` and never `produced`. A signal that cannot be read is
# never a satisfied term.
#
# WHAT IT DOES NOT MEASURE. It does not read the DB: the continuation row's
# `response_text` (mika#1910 U2) is gated by `MIKA_STORE_LLM_CALLS` and serves
# INSPECTION of one occurrence, never the count. It does not compare providers
# or system prompts (investigations 4 and 5 of the ticket): those compare
# populations, and there is no population before this instrument exists. And it
# does not decide whether the window is long enough to make a zero mean
# anything — it reports the two numbers of the criterion and leaves the halt to
# `docs/eval/mika-1910/README.md` §6.
#
# USAGE
#   scripts/measure-empty-turns [--log-file FILE] [--agent NAME]
#                               [--out FILE] [--summary FILE]
#
#   --log-file  default "$MIKA_SPIRIT_LOG_FILE"
#   --agent     restrict to one agent_id (e.g. mika-dev); default: all
#   --out       per-turn JSONL, default stdout (chronological, file order)
#   --summary   aggregate JSON object, default stderr
#
# OUTPUT — one JSON object per CONTINUATION turn, newline-delimited, plus one
# aggregate object carrying `total_trace_ids_scanned` (the denominator, distinct
# trace_ids, not lines), `duplicate_continuation`, the per-class counts, the
# model x month x class breakdown, and the D6 criterion readout.
#
# EXIT CODES
#   0  the corpus was read (zero continuation turns is a RESULT, not a failure —
#      `max_steps = 20` is not the harness's `max_turns = 30`; see README §6)
#   2  nothing was measured: no log file, unreadable, no `turn_usage` line at
#      all, or an --agent filter that matched none. Never 0: a silently inert
#      scan reads exactly like a scan that found nothing to report, and that
#      ambiguity is its own defect class (mika#2205).

set -uo pipefail

LOG_FILE="${MIKA_SPIRIT_LOG_FILE:-}"
AGENT=""
OUT_FILE=""
SUMMARY_FILE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --log-file) LOG_FILE="${2:-}"; shift 2 ;;
        --agent)    AGENT="${2:-}"; shift 2 ;;
        --out)      OUT_FILE="${2:-}"; shift 2 ;;
        --summary)  SUMMARY_FILE="${2:-}"; shift 2 ;;
        -h|--help)  sed -n '2,140p' "$0"; exit 0 ;;
        *) printf 'measure-empty-turns: unknown argument: %s\n' "$1" >&2; exit 2 ;;
    esac
done

if [[ -z "$LOG_FILE" ]]; then
    printf 'measure-empty-turns: no log file — pass --log-file or set MIKA_SPIRIT_LOG_FILE; nothing measured\n' >&2
    exit 2
fi
if [[ ! -f "$LOG_FILE" || ! -r "$LOG_FILE" ]]; then
    printf 'measure-empty-turns: not a readable file: %s — nothing measured\n' "$LOG_FILE" >&2
    exit 2
fi
if ! command -v jq >/dev/null 2>&1; then
    printf 'measure-empty-turns: jq is required — nothing measured\n' >&2
    exit 2
fi

WORK="$(mktemp -d)" || exit 2
trap 'rm -rf "$WORK"' EXIT

# -- the single streaming pass -------------------------------------------------
#
# The log is measured in gigabytes, so nothing is slurped. `grep -F` narrows the
# stream cheaply, `jq -R` parses line by line (and survives a non-JSON line,
# which `jq` without `-R` would abort on, taking the whole measurement with it),
# and awk fans the projection into two small files.
#
# Every matching line contributes its `trace_id` to the denominator; only the
# continuation lines carry a projected record. A continuation line emits BOTH,
# so a turn that reached `max_steps` is never missing from its own denominator.

: >"$WORK/traces"
: >"$WORK/cont"
: >"$WORK/unparseable"

grep -F 'turn_usage' "$LOG_FILE" 2>/dev/null \
    | jq -R -r --arg agent "$AGENT" '
        (try fromjson catch null) as $o
        | if ($o | type) != "object" then "X"
          elif (($o.event? // "") != "turn_usage") then empty
          elif ($agent != "" and (($o.agent_id? // "") != $agent)) then empty
          else
            (($o.trace_id? // "") | tostring) as $tid
            | if (($o.step? | tostring) == "4294967295")
              then
                ("A\t" + $tid),
                ("B\t" + ({
                    trace_id:          (if $tid == "" then null else $tid end),
                    session_id:        ($o.session_id?        // null),
                    agent_id:          ($o.agent_id?          // null),
                    timestamp:         ($o.timestamp?         // null),
                    model:             ($o.model?             // null),
                    provider:          ($o.provider?          // null),
                    stop_reason:       ($o.stop_reason?       // null),
                    output_tokens:     ($o.output_tokens?     // null),
                    input_tokens:      ($o.input_tokens?      // null),
                    status:            ($o.status?            // null),
                    tool_use_in_turn:  ($o.tool_use_in_turn?  // null),
                    response_chars_raw:($o.response_chars?    // null)
                  } | tojson))
              else ("A\t" + $tid)
              end
          end
      ' 2>/dev/null \
    | awk -F'\t' -v T="$WORK/traces" -v C="$WORK/cont" -v X="$WORK/unparseable" '
        $1 == "X" { print "1" > X; next }
        $1 == "A" { if ($2 != "") print $2 > T; next }
        $1 == "B" { sub(/^B\t/, ""); print > C; next }
      '

# `sort -u` on trace ids rather than an in-memory set: the denominator is a
# count of DISTINCT turns and the population that feeds it is the whole log.
TOTAL_TRACES="$(LC_ALL=C sort -u "$WORK/traces" 2>/dev/null | grep -c . || true)"
TOTAL_TRACES="${TOTAL_TRACES:-0}"
UNPARSEABLE="$(grep -c . "$WORK/unparseable" 2>/dev/null || true)"
UNPARSEABLE="${UNPARSEABLE:-0}"

# "Nothing measured" is decided on the DENOMINATOR alone, never on the absence
# of unreadable lines as well.
#
# The unparseable counter is incremented BEFORE the --agent filter (a line that
# is not an object cannot be attributed to an agent), so conjoining the two
# would let ONE malformed line anywhere in the corpus assert that the run
# measured something — for every agent, including one that matched nothing. On a
# 19 GB production log at least one such line is near-certain, which would make
# exit 2 structurally unreachable: the silently-inert scan reading exactly like
# a scan that found nothing to do (mika#2205), in the very script that exists to
# refuse that ambiguity. Found by `scripts/test-measure-empty-turns.sh` (mika#1910).
#
# An unreadable line is not a measurement, so it is REPORTED here rather than
# counted as one — and it still rides on the aggregate as `unparseable_lines`.
if [[ "$TOTAL_TRACES" -eq 0 ]]; then
    if [[ -n "$AGENT" ]]; then
        printf 'measure-empty-turns: no `turn_usage` line for agent %s in %s (%s unreadable line(s)) — nothing measured\n' \
            "$AGENT" "$LOG_FILE" "$UNPARSEABLE" >&2
    else
        printf 'measure-empty-turns: no `turn_usage` line in %s (%s unreadable line(s)) — nothing measured\n' \
            "$LOG_FILE" "$UNPARSEABLE" >&2
    fi
    exit 2
fi

# -- classification and aggregation -------------------------------------------
#
# Slurped, deliberately: this file holds one record per turn that reached
# `max_steps`, three orders of magnitude below the log it came from.

classify() {
    jq -s \
        --arg logfile "$LOG_FILE" \
        --arg agent "$AGENT" \
        --argjson total_traces "$TOTAL_TRACES" \
        --argjson unparseable "$UNPARSEABLE" '

    # The wire form, read from the producer: `?`-sigil Debug through the JSON
    # layer. A bare number is accepted so a future formatter change degrades to
    # correctness; anything else is `null`, i.e. "not measured".
    def chars_of($raw):
        if   $raw == null              then null
        elif ($raw | type) == "number" then ($raw | floor)
        elif ($raw | type) == "string" then
            ( if $raw == "None" then null
              elif ($raw | test("^Some\\(-?[0-9]+\\)$"))
              then ($raw | capture("^Some\\((?<n>-?[0-9]+)\\)$") | .n | tonumber)
              else null end )
        else null end;

    # The predicate. Order is load-bearing — see the header.
    def classe($f; $dup):
        if   $dup                     then "undetermined"
        elif ($f.trace_id == null)    then "undetermined"
        elif ($f.status == "error")   then "error"
        elif ($f.response_chars == null) then "undetermined"
        elif ($f.stop_reason == "MaxTokens"
              and (($f.output_tokens // 0) > 0)
              and $f.response_chars == 0) then "reasoning_budget_exhausted"
        elif ($f.response_chars == 0) then "empty_response"
        elif ($f.response_chars > 0)  then "produced"
        else "undetermined" end;

    def is_glm: ((. // "") | ascii_downcase | contains("glm"));

    # `jq -s` has already parsed each line of "$WORK/cont" into an object: the
    # projection above emitted `tojson` through `jq -r`, so what reached awk was
    # the raw JSON text, not a quoted JSON string. A `map(fromjson)` here would
    # therefore be handed objects and abort with "only strings can be parsed",
    # taking the whole measurement with it — which is what it did until this
    # script first had a test (mika#1910).
    #
    # A null `trace_id` must not merge with another null `trace_id`: two
    # unattributable lines are two unattributable lines, not one turn.
    to_entries
    | map(.value + {_k: (if .value.trace_id == null
                         then "␀unattributed-" + (.key | tostring)
                         else .value.trace_id end)})
    | group_by(._k)
    | map(
        (length > 1) as $dup
        | .[0] as $f0
        | ($f0 + {response_chars: chars_of($f0.response_chars_raw)}) as $f
        | ($f + {
            date:  (if ($f.timestamp | type) == "string" then $f.timestamp[0:10] else null end),
            classe: classe($f; $dup),
            duplicate_continuation_lines: (if $dup then length else 0 end)
          })
        | . + {month: (if .date == null then null else .date[0:7] end)}
        | {trace_id, session_id, agent_id, date, month, model, provider,
           stop_reason, output_tokens, input_tokens, response_chars, status,
           tool_use_in_turn, classe, duplicate_continuation_lines}
      )
    # Chronological where a timestamp exists; unattributable last.
    | sort_by(.date // "9999-99-99")
    | . as $turns
    | ($turns | map(select(.date != null) | .date) | sort) as $dates
    | ($dates | first) as $first_date
    | ($dates | last)  as $last_date
    | ($turns | map(select(.model | is_glm))) as $glm
    | {
        turns: $turns,
        summary: {
          log_file: $logfile,
          agent_filter: (if $agent == "" then null else $agent end),
          total_trace_ids_scanned: $total_traces,
          continuation_turns: ($turns | length),
          duplicate_continuation: ($turns | map(select(.duplicate_continuation_lines > 1)) | length),
          unparseable_lines: $unparseable,
          missing_trace_id: ($turns | map(select(.trace_id == null)) | length),
          by_class: ($turns | group_by(.classe)
                     | map({key: .[0].classe, value: length}) | from_entries),
          models_seen: ($turns | map(.model // "null") | unique),
          glm_continuation_turns: ($glm | length),
          glm_by_class: ($glm | group_by(.classe)
                         | map({key: .[0].classe, value: length}) | from_entries),
          by_model_month_class:
            ($turns
             | group_by([(.model // "null"), (.month // "null"), .classe])
             | map({model: (.[0].model), month: (.[0].month),
                    classe: (.[0].classe), count: length})),
          window: {
            first_date: $first_date,
            last_date:  $last_date,
            # Inclusive span: a single-day corpus spans one day. `null` rather
            # than a guess when the platform `jq` has no `strptime`.
            days_spanned:
              (if ($first_date == null or $last_date == null) then null
               else (try ((((($last_date | strptime("%Y-%m-%d") | mktime)
                            - ($first_date | strptime("%Y-%m-%d") | mktime)) / 86400)
                          | floor) + 1) catch null)
               end)
          },
          # A READOUT of the declared criterion (plan D6), never a verdict: the
          # halt that reads it lives in README §6. `met: null` means the span
          # could not be computed, which is not "not met".
          d6_criterion: {
            days_required: 14,
            glm_continuation_turns_required: 20,
            glm_continuation_turns: ($glm | length),
            met: null
          }
        }
      }
    | .summary.d6_criterion.met =
        (if .summary.window.days_spanned == null then null
         else (.summary.window.days_spanned >= 14
               and .summary.glm_continuation_turns >= 20) end)
    ' "$WORK/cont"
}

RESULT="$(classify)" || {
    printf 'measure-empty-turns: classification failed — nothing measured\n' >&2
    exit 2
}

emit_turns() { printf '%s' "$RESULT" | jq -c '.turns[]'; }
emit_summary() { printf '%s' "$RESULT" | jq '.summary'; }

if [[ -n "$OUT_FILE" ]]; then
    emit_turns >"$OUT_FILE"
else
    emit_turns
fi

if [[ -n "$SUMMARY_FILE" ]]; then
    emit_summary >"$SUMMARY_FILE"
else
    emit_summary >&2
fi
