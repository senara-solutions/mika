[
  {
    "name": "get_documentation",
    "description": "Get Mika's own documentation on a specific topic.",
    "input_schema": {
      "type": "object",
      "properties": {
        "topic": {
          "type": "string",
          "enum": [
            "architecture",
            "api-spec",
            "cli-reference",
            "configuration",
            "deployment",
            "getting-started",
            "runtime-structure",
            "skills",
            "slash-commands"
          ],
          "description": "Which documentation topic to retrieve"
        }
      },
      "required": ["topic"]
    },
    "handler": {
      "type": "builtin",
      "function": "get_documentation"
    }
  }
]
